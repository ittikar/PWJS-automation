# Copy to .env (git ignores it). Everything here is optional; without it the API tests run against
# SIT with the accounts in test-data/.

# Which environment the API tests call: sit (default) or dev.
# ITTI_ENV=sit

# Override the accounts in test-data/dealUser.json and test-data/dataRoomRequester.json,
# e.g. to use dev accounts. Both email and password must be set for an override to apply.
# DEAL_USER_EMAIL=
# DEAL_USER_PASSWORD=
# DATA_ROOM_REQUESTER_EMAIL=
# DATA_ROOM_REQUESTER_PASSWORD=

# Sumsub sandbox credentials, for the club deal participant tests in API-005.
# SUMSUB_APP_TOKEN=
# SUMSUB_SECRET_KEY=
